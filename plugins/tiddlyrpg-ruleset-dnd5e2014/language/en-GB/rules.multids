title: $:/tiddlyrpg/language/en-GB/

# Units, dice and the damage grammar of D&D 5e (2014) in English; factors of the SRD 5.1 per pair:
# in -> cm 2.5 and ft -> m 0.3 (en p. 134 "1 foot of stone, 1 inch of common metal ... 3 feet of wood",
# de p. 132 "30 Zentimeter ... 2,5 Zentimeter ... 90 Zentimeter"; en p. 5 "5 by 30 ft. line", de p. 5
# "1,5 m x 9 m"), mi -> km 1.6 (en p. 84 "30 miles" per day, de p. 91 "48 km"), lb -> kg 0.5 (en p. 66
# handaxe "2 lb.", de p. 69 Beil "1 kg"). The German SRD rounds unevenly (de p. 152 "einem Meter" for 3 feet).

Rules/System/Name: D&D 5e (2014, SRD 5.1)
Rules/Unit/System: imperial

# Names of the domains
Rules/Domain/Ability: Abilities
Rules/Domain/Action: Actions
Rules/Domain/Alignment: Alignments
Rules/Domain/Condition: Conditions
Rules/Domain/CreatureType: Creature types
Rules/Domain/Damage: Damage
Rules/Domain/Dice: Dice
Rules/Domain/Language: Languages
Rules/Domain/Length: Length
Rules/Domain/Mechanics: Mechanics
Rules/Domain/School: Schools of magic
Rules/Domain/Sense: Senses
Rules/Domain/Size: Sizes
Rules/Domain/Skill: Skills
Rules/Domain/Spellcasting: Spellcasting
Rules/Domain/Terms: Terms
Rules/Domain/Weight: Weight

# Units and the words read for them
Rules/Unit/in: in
Rules/Unit/in/Parse: in., inch, inches
Rules/Unit/ft: ft
Rules/Unit/ft/Parse: ft., feet, foot
Rules/Unit/mi: mi
Rules/Unit/mi/Parse: mi., mile, miles
Rules/Unit/lb: lb
Rules/Unit/lb/Parse: lb., lbs, lbs., pound, pounds
Rules/Unit/cm: cm
Rules/Unit/cm/Parse: centimeter, centimeters, centimetre, centimetres
Rules/Unit/m: m
Rules/Unit/m/Parse: meter, meters, metre, metres
Rules/Unit/km: km
Rules/Unit/km/Parse: kilometer, kilometers, kilometre, kilometres
Rules/Unit/kg: kg
Rules/Unit/kg/Parse: kilogram, kilograms

# Dice: the token of NdM ("1d6")
Rules/Token/die: d

# Damage: pattern and join as in stat blocks ("... slashing damage plus 4 (1d8) necrotic damage");
# words read and dropped; written variants of the types
Rules/Damage/Pattern: $dice$ $qualifiers$ $type$
Rules/Damage/Join: plus
Rules/Damage/Joiners: plus, and
Rules/Damage/Fillers: damage, dmg
Rules/Damage/Extras: extra
Rules/Damage/bludgeoning/Parse: bludgeon
Rules/Damage/piercing/Parse: pierce
Rules/Damage/slashing/Parse: slash

# Names of the domains of the fields of items, spells and creatures
Rules/Domain/Area: Areas of effect
Rules/Domain/Challenge: Challenge ratings
Rules/Domain/Class: Classes
Rules/Domain/Component: Components
Rules/Domain/DamageGroup: Damage beside the types
Rules/Domain/ItemCategory: Item categories
Rules/Domain/Movement: Movement
Rules/Domain/Rarity: Rarity
Rules/Domain/SaveSuccess: Saving throw results
Rules/Domain/Speed: Speed
Rules/Domain/SpellAttack: Spell attacks
Rules/Domain/SpellWord: Range and duration words
Rules/Domain/Time: Time
Rules/Domain/Volume: Volume

# Time (no conversion, labels only): p. 144 "Casting Time: 1 action", p. 123 "1 bonus action",
# p. 131 "1 reaction", p. 124 "1 round", p. 144 "10 minutes", p. 114 "8 hours", p. 117 "10 days"
Rules/Unit/action: action
Rules/Unit/action/Plural: actions
Rules/Unit/action/Parse: actions
Rules/Unit/bonus-action: bonus action
Rules/Unit/bonus-action/Plural: bonus actions
Rules/Unit/bonus-action/Parse: bonus actions
Rules/Unit/reaction: reaction
Rules/Unit/reaction/Plural: reactions
Rules/Unit/reaction/Parse: reactions
Rules/Unit/round: round
Rules/Unit/round/Plural: rounds
Rules/Unit/round/Parse: rounds, rd.
Rules/Unit/minute: minute
Rules/Unit/minute/Plural: minutes
Rules/Unit/minute/Parse: minutes, min, min.
Rules/Unit/hour: hour
Rules/Unit/hour/Plural: hours
Rules/Unit/hour/Parse: hours, hr
Rules/Unit/day: day
Rules/Unit/day/Plural: days
Rules/Unit/day/Parse: days

# Speed of vehicles: p. 72 "Galley ... 4 mph" (de p. 76 "6,4 km/h": factor 1.6)
Rules/Unit/mph: mph
Rules/Unit/mph/Parse: miles per hour, mile per hour
Rules/Unit/kmh: km/h
Rules/Unit/kmh/Parse: kilometers per hour, kilometres per hour, kph

# Volume: p. 70 "Jug or pitcher 1 gallon liquid" (de p. 74 "4 Liter": factor 4), p. 210 Bag of
# Holding "64 cubic feet" (de p. 249 "1.792 Liter": factor 28)
Rules/Unit/gal: gal
Rules/Unit/gal/Parse: gallon, gallons
Rules/Unit/ft3: ft³
Rules/Unit/ft3/Parse: cubic feet, cubic foot, cu ft, ft3
Rules/Unit/l: l
Rules/Unit/l/Parse: liter, liters, litre, litres

